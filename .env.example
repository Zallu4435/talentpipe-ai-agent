# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# Google Gemini AI Configuration
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Google Sheets Configuration
GOOGLE_SHEETS_DOC_ID=your_google_sheets_document_id_here
GOOGLE_SHEETS_SHEET_ID=gid=0

# Redis Configuration
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# Supabase Configuration
SUPABASE_API_URL=your_supabase_api_url_here
SUPABASE_API_KEY=your_supabase_api_key_here

# n8n Configuration (if self-hosted)
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
